# Copy to dashboard/.env and fill in the two required secrets. This file is the app service's env
# file in the dashboard overlay; it never leaves the machine.
#
# Phase 1: the overlay also starts a local stand-in for the single shared CVM Execution Host.
# Production uses docker-compose.rpc.yml (the existing mTLS gateway); see
# docs/runbook-shared-execution-host.md. Nothing here changes the CVM or its firewall.
#
# The console token: 16-256 printable characters without spaces. Required by default
# (WEB_AUTH=token); every /api/* route including SSE checks it. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
WEB_TOKEN=
# WEB_AUTH=token is the fail-closed default. WEB_AUTH=off disables token authentication entirely:
# only use it when the console's sole reachable ingress is a loopback bind plus an SSH tunnel or
# an authenticated reverse proxy, and that boundary owns authentication. Do not put off in a
# shared env file. Any other value fails startup. The static page stays public either way.
# WEB_AUTH=token
# The model provider and its single API key (see src/providers.ts for the supported list).
MODEL_PROVIDER=deepseek
MODEL_ID=
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional container deployment knobs (compose interpolation only). The local execution-host
# stand-in uses the same ASTER_IMAGE as the app; there is no separate sandbox image to build.
# ASTER_IMAGE=aster:local
# ASTER_EXECUTION_RUNTIME_VOLUME=aster-execution-runtime
# ASTER_EXECUTION_WORKSPACES_VOLUME=aster-execution-workspaces

# Optional behavior. Memory and reminders are off in the dashboard MVP.
# MEMORY_ENABLED=0
# REMINDERS_ENABLED=0

# Zero-setup is the default: the first bot is created and initialized automatically, and no tool,
# MCP, API key or capability needs to be configured by the user.
# Optional host-owned Web credential; unset means the web capability is honestly reported as
# unavailable on the platform status panel (never faked as ready).
# PLATFORM_WEB_SEARCH_API_KEY=
# Host-only compatibility switch for dashboard/acceptance/run.sh (legacy explicit-profile checks,
# including the retired-ptc negative case). Leave at 0 for normal deployments; invalid values fail startup.
# ALLOW_LEGACY_CATALOG=0
