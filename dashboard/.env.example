# Copy to dashboard/.env and fill in the two required secrets. This file is the app service's env
# file in the dashboard overlay; it never leaves the machine.
#
# The console token: 16-256 printable characters without spaces. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
WEB_TOKEN=
# The model provider and its single API key (see src/providers.ts for the supported list).
MODEL_PROVIDER=deepseek
MODEL_ID=
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional container deployment knobs (compose interpolation only).
# ASTER_IMAGE=aster:local
# ASTER_SANDBOX_IMAGE=aster-sandbox:local
# ASTER_SANDBOX_RUNTIME_VOLUME=aster-sandbox-runtime
# ASTER_SANDBOX_WORKSPACES_VOLUME=aster-sandbox-workspaces

# Optional behavior. Memory and reminders are off in the dashboard MVP.
# MEMORY_ENABLED=0
# REMINDERS_ENABLED=0

# Zero-setup is the default: the first bot is created and initialized automatically, and no tool,
# MCP, API key or capability needs to be configured by the user.
# Optional host-owned Web credential; unset means the web capability is honestly reported as
# unavailable on the platform status panel (never faked as ready).
# PLATFORM_WEB_SEARCH_API_KEY=
# Host-only compatibility switch for dashboard/acceptance/run.sh (legacy explicit profile/PTC
# checks). Leave at 0 for normal deployments; invalid values fail startup.
# ALLOW_LEGACY_CATALOG=0
